{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm chess:ensure && pnpm storybook:publish && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "chess:pull": "node --experimental-strip-types --no-warnings scripts/chess-pull.ts",
    "chess:ensure": "node --experimental-strip-types --no-warnings scripts/chess-pull.ts --if-missing",
    "stockfish:copy": "node scripts/copy-stockfish.mjs",
    "postinstall": "node scripts/copy-stockfish.mjs",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "storybook:publish": "node scripts/publish-storybook.mjs"
  },
  "dependencies": {
    "@lichess-org/chessground": "^10.1.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "chess.js": "^1.4.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/nextjs-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "postcss": "^8.5",
    "prettier": "^3.9.5",
    "shadcn": "^4.13.1",
    "storybook": "^10.5.10",
    "storybook-dark-mode": "^5.0.0",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3",
    "vite": "^8.2.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,css,md,json}": [
      "prettier --write"
    ]
  }
}
