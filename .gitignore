# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
.pnpm-store

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# macOS
.DS_Store

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw Accumulation Index archive (source scans; curated assets live in public/)
/accumulation-index/

# Chess.com dumps — regenerate with `pnpm chess:pull` (do not commit)
/data/chess-coach/pgn/chesscom-*.pgn

# Stockfish WASM — copied from node_modules on install (`pnpm stockfish:copy`)
/public/vendor/stockfish/*.js
/public/vendor/stockfish/*.wasm